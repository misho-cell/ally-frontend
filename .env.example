# The backend. Production is api.netai.guru; the Railway host below it is the
# old one and is kept only because old notes still mention it.
#
# You do NOT need this set to work in the container. Nothing here runs the app
# against a real API: the container typechecks, lints and builds, and that is
# all. The value that reaches people is set on the host that deploys main to
# netai.guru, not here. Setting it locally changes only your own build.
NEXT_PUBLIC_API_URL=https://api.netai.guru

# Paddle's browser token. The live payment path is Stripe; Paddle is older and
# the code asserts this is present, so leave it unset rather than inventing a
# value — an invented token fails at the till, where it costs somebody a
# purchase, instead of failing here where it costs nothing.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Set automatically by Vercel. Shown in the build tag; reads "dev" without it.
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
